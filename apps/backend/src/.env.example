# DO NOT commit your .env file to version control.

# Server
PORT=3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/moosathegreat?schema=public"

# JWT
JWT_SECRET="a-very-strong-and-long-secret-for-jwt-that-is-at-least-32-characters"
JWT_EXPIRES_IN="1h"

# API Keys
OPENAI_API_KEY="sk-..."

# Discord
DISCORD_BOT_TOKEN="your-discord-bot-token"